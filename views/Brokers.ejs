<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">

  <title>Brokers</title>
  <style>
    /* خلفية جذابة */
    body {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      background: linear-gradient(135deg, #ff2770, #313638, #808080);
      background-size: cover;
      font-family: Arial, sans-serif;
      color: white;
      text-align: center;
    }

    h1 {
      font-size: 40px;
      margin-bottom: 20px;
      text-transform: uppercase;
      letter-spacing: 2px;
      animation: fadeInDown 1s ease-in-out;
    }

    /* حاوية الوسطاء */
    .broker-container {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
      justify-content: center;
    }

    /* تصميم البطاقة */
    .broker {
      border: 1px solid rgba(255, 255, 255, 0.2);
      padding: 20px;
      width: 260px;
      text-align: center;
      border-radius: 12px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
      background: rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(15px);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .broker:hover {
      transform: scale(1.05);
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
    }

    .broker img {
      width: 100px;
      height: 100px;
      border-radius: 50%;
      border: 3px solid white;
      transition: transform 0.3s ease;
    }

    .broker img:hover {
      transform: rotate(10deg);
    }

    .broker h3 {
      margin-top: 10px;
      font-size: 18px;
    }

    .broker p {
      font-size: 14px;
      color: #eee;
    }

    .broker a {
      display: inline-block;
      font-size: 20px;
      color: #FFD700;
      margin: 10px 5px;
      transition: color 0.3s ease, transform 0.2s ease;
    }

    .broker a:hover {
      color: #ff2770;
      transform: scale(1.2);
    }

    /* تقييم النجوم */
    .star-rating {
      display: flex;
      justify-content: center;
      margin-top: 10px;
    }

    .star-rating i {
      font-size: 22px;
      color: #FFD700;
      cursor: pointer;
      transition: transform 0.2s ease;
    }

    .star-rating i:hover,
    .star-rating i.active {
      color: #FFAC33;
      transform: scale(1.3);
    }

    /* زر التقييم */
    .evaluate-btn {
      background: linear-gradient(45deg, #ff2770, #ff5733);
      color: white;
      border: none;
      padding: 10px 20px;
      font-size: 16px;
      font-weight: bold;
      border-radius: 8px;
      cursor: pointer;
      transition: background 0.3s ease, transform 0.2s ease, box-shadow 0.3s ease;
      margin-top: 10px;
    }

    .evaluate-btn:hover {
      background: linear-gradient(45deg, #ff5733, #ff2770);
      transform: scale(1.1);
      box-shadow: 0 0 10px rgba(255, 39, 112, 0.6);
    }

    /* نافذة التقييم */
    .rating-popup {
      display: none;
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%) scale(0.9);
      background: rgba(255, 255, 255, 0.9);
      padding: 20px;
      box-shadow: 0 0 20px rgba(0, 0, 0, 0.3);
      border-radius: 12px;
      width: 300px;
      text-align: center;
      animation: fadeIn 0.5s ease-in-out;
    }

    .rating-popup textarea,
    .rating-popup select {
      width: 100%;
      margin: 10px 0;
      padding: 8px;
      border-radius: 5px;
      border: 1px solid #ccc;
    }

    .rating-popup button {
      background: #28a745;
      color: white;
      border: none;
      padding: 10px;
      cursor: pointer;
      border-radius: 5px;
      margin-top: 10px;
    }

    .rating-popup button.close-btn {
      background: red;
    }

    /* أنميشن الظهور */
    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translate(-50%, -50%) scale(0.7);
      }
      to {
        opacity: 1;
        transform: translate(-50%, -50%) scale(1);
      }
    }

    @keyframes fadeInDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>
</head>
<body>
    <h1>وسطاء <form action="/home" method="POST" style="display: inline;">
      <button type="submit" class="evaluate-btn">Home</button>
  </form></h1>
  <div class="broker-container">
    <% brokers.forEach(broker => { %>
      <div class="broker">
        <img src="<%= broker.image %>" alt="<%= broker.name %>">
        <h3>Name: <%= broker.name %> // ID: <%= broker.id %></h3>
        <h3><%= broker.phone %></h3>
        <p><%= broker.details %></p>
        <a href="<%= broker.website %>" target="_blank">
          <i class="fas fa-globe"></i>
        </a>
        <a href="<%= broker['Facebook-account'] %>" target="_blank">
          <i class="fab fa-facebook-f"></i>
        </a>
        <a href="<%= broker.Instagram_account %>" target="_blank">
          <i class="fab fa-instagram"></i>
        </a>
        <div class="star-rating">
          <i class="fas fa-star"></i>
        </div>
        <button class="evaluate-btn" data-id="<%= broker.id %>">تقيم/Evaluate</button>
      </div>
    <% }) %>
  </div>

  <!-- نافذة التقييم -->
  <div id="rating-popup" class="rating-popup">
    <h3>تقييم الوسيط</h3>
    <p>Broker ID: <span id="broker-id"></span></p>
    <textarea id="comment" placeholder="أدخل تعليقك هنا"></textarea>
    <select id="rating">
      <option value="1">⭐ 1</option>
      <option value="2">⭐⭐ 2</option>
      <option value="3">⭐⭐⭐ 3</option>
      <option value="4">⭐⭐⭐⭐ 4</option>
      <option value="5">⭐⭐⭐⭐⭐ 5</option>
    </select>
    <button id="submit-rating">إرسال</button>
    <button class="close-btn">إغلاق</button>
  </div>

  <script>
    // الحصول على جميع أزرار التقييم
    const evaluateButtons = document.querySelectorAll('.evaluate-btn');
    const ratingPopup = document.getElementById('rating-popup');
    const brokerIdSpan = document.getElementById('broker-id');
    const closeBtn = document.querySelector('.close-btn');

    // عند النقر على زر "تقييم"
    evaluateButtons.forEach(button => {
      button.addEventListener('click', () => {
        const brokerId = button.getAttribute('data-id'); // جلب ID الوسيط
        brokerIdSpan.textContent = brokerId; // عرض الـ ID داخل النافذة
        ratingPopup.style.display = 'block'; // إظهار النافذة
      });
    });

    // عند الضغط على زر الإغلاق
    closeBtn.addEventListener('click', () => {
      ratingPopup.style.display = 'none'; // إخفاء النافذة
    });

    // عند إرسال التقييم
    document.getElementById('submit-rating').addEventListener('click', () => {
      const comment = document.getElementById('comment').value;
      const rating = document.getElementById('rating').value;
      const brokerId = brokerIdSpan.textContent;

      console.log(`Broker ID: ${brokerId}, Rating: ${rating}, Comment: ${comment}`);

      // يمكنك إرسال البيانات إلى الخادم هنا باستخدام AJAX أو Fetch API
      ratingPopup.style.display = 'none'; // إخفاء النافذة بعد الإرسال
    });
  </script>
</body>
</html>
