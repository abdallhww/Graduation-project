<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style/broker.css">
  <title>Brokers</title>
</head>
<body>
  <h1>Our Brokers</h1>
  <div class="broker-container">
    <% brokers.forEach(broker => { %>
      <div class="broker">
        <h1><%=broker.id %></h1>
        <img src="<%= broker.image %>" alt="<%= broker.name %>">
        <h3><%= broker.name %></h3>
        <h3><%= broker.phone %></h3>
        <p><%= broker.details %></p>
        <a href="<%= broker.website %>" target="_blank">
          <i class="fas fa-globe"></i></a>
        <a href="<%= broker['Facebook-account'] %>" target="_blank">
          <i class="fab fa-facebook-f"></i>
        </a>
        <a href="<%= broker.Instagram_account %>" target="_blank">
          <i class="fab fa-instagram"></i>
        </a>
        <div class="star-rating">
          <i class="fas fa-star"></i>
          <i class="fas fa-star"></i>
          <i class="fas fa-star"></i>
          <i class="fas fa-star"></i>
          <i class="fas fa-star"></i>
        </div>
        <button>تقيم/Evaluate</button>
      </div>
    <% }) %>
  </div>
  <script>
    // إضافة وظائف النجوم
    const stars = document.querySelectorAll('.star-rating i');
    
    stars.forEach((star, index) => {
      star.addEventListener('click', () => {
        // إزالة التحديد من جميع النجوم
        stars.forEach(s => s.classList.remove('active'));
        // إضافة التحديد على النجوم التي تم النقر عليها
        for (let i = 0; i <= index; i++) {
          stars[i].classList.add('active');
        }
      });
    });
  </script>
</body>
</html>
