<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/style/broker.css">
  <title>Brokers</title>
  <style>
    .view-comments-btn {
      background: linear-gradient(45deg, #58d77c, #025c1a);
  color: white;
  border: none;
  padding: 10px 20px;
  font-size: 16px;
  font-weight: bold;
  border-radius: 8px;
  cursor: pointer;
  transition: background 0.3s ease, transform 0.2s ease, box-shadow 0.3s ease;
  margin-top: 10px;
}

.view-comments-btn:hover {
  background: linear-gradient(45deg, #1ff51c, #012b10);
  transform: scale(1.1);
  box-shadow: 0 0 10px rgba(39, 255, 93, 0.6);
}

.view-comments-btn:active {
  background-color: #3e8e41; /* لون خلفية أخضر داكن عند النقر */
}
.comments-popup {
  display: none;
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background-color: white;
  padding: 20px;
  border: 1px solid #ccc;
  box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
  z-index: 1000;
}

.comment {
  margin-bottom: 10px;
  padding: 10px;
  border-bottom: 1px solid #eee;
}
  </style>
</head>
<body>
  <div class="alert-container mt-2">
    <% if (message) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <%= message %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>
</div>
    <h1>الوسطاء <form action="/home" method="POST" style="display: inline;">
      <button type="submit" class="evaluate-btn">الصفحه الرئيسيه</button>
  </form></h1>
  <div class="broker-container">
    <% brokers.forEach(broker => { %>
      <div class="broker">
        <div class="vv">
          <h4>معرف:<%= broker.id %></h4>
        </div>
        <img src="<%= broker.image %>" alt="<%= broker.name %>">
        <h3>الاسم: <%= broker.name %></h3>
        <h3><%= broker.phone %></h3>
        <p><%= broker.details %></p>
        <a href="<%= broker.website %>" target="_blank">
          <i class="fas fa-globe"></i>
        </a>
        <a href="<%= broker['Facebook-account'] %>" target="_blank">
          <i class="fab fa-facebook-f"></i>
        </a>
        <a href="<%= broker.Instagram_account %>" target="_blank">
          <i class="fab fa-instagram"></i>
        </a>
        <div class="star-rating">
         <h3> <%=broker.Rating%> </h3> <i class="fas fa-star"></i>
        </div>
        <button class="evaluate-btn" data-id="<%= broker.id %>" >تقييم وسيط </button>
        <form action="/viwecommnt" method="POST">
        <button class="view-comments-btn" data-id="<%= broker.id %>">عرض التعليقات</button>
        </form>
      </div>
    <% }) %>
  </div>

  <!-- نافذة التقييم -->
  <div id="rating-popup" class="rating-popup">
    <h3 style="color: black;" >تقييم الوسيط</h3>
    <p style="color: black;" >معرف : <span id="broker-id"></span></p>
    <form action="/evaluate" method="POST">
      <p style="color: black;" >ادخل معرف وسيط<input type="number" id="broker-id" name="broker_id"></p>
      <textarea id="comint" name="comint" placeholder="أدخل تعليقك هنا"></textarea>
      <select id="rating" name="rating">
        <option value="1">⭐ 1</option>
        <option value="2">⭐⭐ 2</option>
        <option value="3">⭐⭐⭐ 3</option>
        <option value="4">⭐⭐⭐⭐ 4</option>
        <option value="5">⭐⭐⭐⭐⭐ 5</option>
      </select>
      <button type="submit">إرسال</button>
  </form>
  <button class="close-btn">إغلاق</button>
  </div>

  <!-- نافذة عرض التعليقات -->
<div id="comments-popup" class="rating-popup ">
  <h3 style="color: black;">تعليقات الوسيط</h3>
  <p style="color: black;">معرف: <span id="comments-broker-id"></span></p>
  <div id="comments-list">
    <!-- سيتم عرض التعليقات هنا -->
  </div>
  <button class="close-btn">إغلاق</button>
</div>

  <script>
    // الحصول على جميع أزرار التقييم
    const evaluateButtons = document.querySelectorAll('.evaluate-btn');
    const ratingPopup = document.getElementById('rating-popup');
    const brokerIdSpan = document.getElementById('broker-id');
    const closeBtn = document.querySelector('.close-btn');

    //  النقر على زر "تقييم"
    evaluateButtons.forEach(button => {
      button.addEventListener('click', () => {
        const brokerId = button.getAttribute('data-id'); // جلب ID الوسيط
        brokerIdSpan.textContent = brokerId; // عرض الـ ID داخل النافذة
        ratingPopup.style.display = 'block'; // إظهار النافذة
      });
    });

    //  الضغط على زر الإغلاق
    closeBtn.addEventListener('click', () => {
      ratingPopup.style.display = 'none'; // إخفاء النافذة
    });

    //  إرسال التقييم
    document.getElementById('submit-rating').addEventListener('click', () => {
      const comment = document.getElementById('comment').value;
      const rating = document.getElementById('rating').value;
      const brokerId = brokerIdSpan.textContent;

      console.log(`Broker ID: ${brokerId}, Rating: ${rating}, Comment: ${comment}`);

      ratingPopup.style.display = 'none'; // إخفاء النافذة بعد الإرسال
    });
  </script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
const viewCommentsButtons = document.querySelectorAll('.view-comments-btn');
const commentsPopup = document.getElementById('comments-popup');
const commentsBrokerIdSpan = document.getElementById('comments-broker-id');
const commentsList = document.getElementById('comments-list');

viewCommentsButtons.forEach(button => {
  button.addEventListener('click', async () => {
    const brokerId = button.getAttribute('data-id'); // جلب ID الوسيط
    commentsBrokerIdSpan.textContent = brokerId; // عرض الـ ID داخل النافذة
    commentsPopup.style.display = 'block'; // إظهار النافذة
  });
});
document.querySelectorAll('.close-btn').forEach(button => {
  button.addEventListener('click', () => {
    commentsPopup.style.display = 'none'; // إخفاء النافذة
  });
});
  </script>
</body>
</html>