<!DOCTYPE html>
<html lang="ar">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ملف المستخدم</title>
    <link rel="stylesheet" href="/style/profile2.css">
   
</head>
<body>

    <div class="profile-container">
        <div class="profile-image">
            <img class="profile-pic" src="<%= user.profile_picture %>" alt="<%= user.username %>" />
        </div>
        <div class="profile-details">
            <h2>ملف شخصي</h2>

            <div class="upload-image">
                <h3>تحميل صورة الملف الشخصي الجديدة</h3>
                <form action="/upload" method="POST" enctype="multipart/form-data">
                    <input type="file" name="image" required />
                    <button type="submit" class="upload-btn">رفع</button>
                </form>
            </div>

            <h4>تم الإنشاء في: "<%= new Date(user.created_at).toLocaleString() %>" </h4>

            <form action="/updateusers" method="POST">
                <label>الاسم:</label>
                <input type="text" name="username" value="<%= user.username %>" required>

                <label>ايميل:</label>
                <input type="email" name="email" value="<%= user.email %>" required>

                <label>رقم هاتف:</label>
                <input type="text" name="phone" value="<%= user.phone %>">

                <label>كلمة السر:</label>
                <input type="text" name="password" value="<%= user.password %>">

                <button type="submit" class="update-btn">تعديل</button>
            </form>

            <!-- الأزرار الجانبية -->
            <div class="button-group">
                <form action="/home" method="POST">
                    <button type="submit" class="logout-btn">الصفحه الرئيسيه</button>
                </form>

                <form action="/user/messages" method="get">
                    <button type="submit" class="update-btn">عرض رسائلي</button>
                </form>

                <form action="/orders/<%= user.id %>" method="GET">
                    <button type="submit" class="update-btn">عرض طلباتي</button>
                </form>

                <form action="/logout" method="POST">
                    <button type="submit" class="logout-btn">تسجيل خروج</button>
                </form>

                <button onclick="goBack()">رجوع</button>
            </div>

        </div>
    </div>

    <script>
      function goBack() {
        window.history.back();
      }
    </script>

</body>
</html>
