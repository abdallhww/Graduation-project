<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Broker Profile</title>
    <link rel="stylesheet" href="/style/profilebroker.css">
</head>
<body>
    <div class="profile-container">
        <div class="profile-image">
            <img class="profile-pic" src="<%= broker.image %>" alt="<%= broker.name %>" />
        </div>

        <div class="upload-image">
        </div>
        
        <div class="profile-details">
            <h3>Upload New Profile Picture</h3>
            <form action="/upload" method="POST" enctype="multipart/form-data">
                <input type="file" name="image" required />
                <button type="submit" class="upload-btn">Upload</button>
            </form>
            <form action="/updateBroker" method="POST">
                <label>Name:</label>
                <input type="text" name="name" value="<%= broker.name %>" required>

                <label>Email:</label>
                <input type="email" name="email" value="<%= broker.emil %>" required>

                <label>Phone:</label>
                <input type="text" name="phone" value="<%= broker.phone %>">

                <label>Facebook Account:</label>
                <input type="text" name="facebook" value="<%= broker.Facebook_account %>">

                <label>Instagram Account:</label>
                <input type="text" name="instagram" value="<%= broker.Instagram_account %>">

                <label>Website:</label>
                <input type="text" name="website" value="<%= broker.website %>">

                <label>Details:</label>
                <textarea name="details"><%= broker.details %></textarea>

                <button type="submit" class="update-btn">Update Profile</button>
            </form>

            <div>
                <form action="/home" method="POST" style="display: inline;">
                    <button type="submit" class="home-btn">Home</button>
                </form>
                <a href="/logout">
                    <button type="button" class="logout-btn">Logout</button>
                </a>
            </div>
        </div>
    </div>
</body>
</html>
