<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Profile</title>
    <link rel="stylesheet" href="/style/profileselers.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        .alert-container {
            position: fixed;
            top: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 50%;
            z-index: 1050;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="alert-container mt-2">
        <% if (message) { %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <%= message %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>
    </div>
    <div class="container">
        <div class="sidebar">
            <h3>إضافة منتج جديد</h3>
            <form action="/addProduct" method="POST">
                <label>اسم المنتج</label>
                <input type="text" name="name" required>

                <label>وصف</label>
                <textarea name="description" required></textarea>

                <label>سعر</label>
                <input type="text" name="price" required>

                <label>كمية المخزون</label>
                <input type="number" name="stock_quantity" required>

                <label>فئة</label>
                <select name="category" id="category" required>
                    <option value="Electronics">إلكترونيات</option>
                    <option value="Clothing">ملابس</option>
                    <option value="Food">طعام</option>
                    <option value="Beauty">ادواة تجميل</option>
                    <option value="Books">كتب </option>
                    <option value="Furniture">اثاث</option>
                    <option value="Perfumes">عطور</option>

                </select>

                <button type="submit">اضافة منتج</button>
            </form>
        </div>
        <div class="profile-container">
            <h2 style="color: rgb(239, 179, 69);" >ملف شخصي </h2>

            <div class="profile-image">
                <img class="profile-pic" src="<%= user.profile_picture %>" alt="<%= user.username %>" />
            </div>
            <div class="upload-image">
                <h3 style="color: rgb(239, 179, 69);" >تحميل صورة الملف الشخصي الجديدة</h3>
                <form action="/upload" method="POST" enctype="multipart/form-data">
                    <input type="file" name="image" required />
                    <button type="submit" class="upload-btn">رفع</button>
                </form>
            </div>
            <div class="profile-details">
                <form action="/updateusers" method="POST">
                    <label>الاسم:</label>
                    <input type="text" name="username" value="<%= user.username %>" required>
    
                    <label>ايميل:</label>
                    <input type="email" name="email" value="<%= user.email %>" required>
    
                    <label>هاتف:</label>
                    <input type="text" name="phone" value="<%= user.phone %>">
    
                    <label>كلمة سر:</label>
                    <input type="text" name="password" value="<%= user.password %>">
    
                    <button type="submit" class="update-btn">تعديل</button>
                </form>
                <form action="/home" method="POST" style="display: inline;">
                    <button type="submit" class="logout-btn">home</button>
                </form>
                <form action="/productsellerid" method="POST" style="display: inline;">
                    <button type="submit" class="logout-btn">عرض منتجات</button>
                </form>

                <a href="/logout">
                    <button type="button" class="logout-btn">تسجيل خروج</button>
                </a>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
