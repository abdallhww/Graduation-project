<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Food Delivery App</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet">
    <link rel="stylesheet" href="/style/viweprodect.css">
    
    <style>
    .like-button {
    font-size: 20px;
    cursor: pointer;
    border: none;
    background: none;
    transition: color 0.3s;
}

.like-button.liked {
    color: red;
}

    </style>
</head>
<body>
    <!-- زر السلة -->
    <div class="cart-icon" onclick="toggleCart()">
        🛒 <span id="cart-count">0</span>
    </div>

    <!-- صندوق السلة -->
    <div class="cart-container" id="cart-container">
        <h3>سلة التسوق</h3>
        <div class="cart-items" id="cart-items"></div>
        
        <!-- عرض إجمالي السعر -->
    <div class="cart-total">
        <strong>المجموع: </strong><span id="cart-total-price">0</span>$
    </div>

        <button class="order-button" onclick="placeOrder()">تسجيل الطلب</button>
        <button onclick="clearCart()">مسح السلة</button>
    </div>

    <div class="app-container">
        <div id="main-app" class="screen">
            <div class="content-container">
                <div id="home-screen" class="screen-content active">
                    <header class="header">
                        <h1 class="logo">Shop</h1>
                        <nav>
                            <a href="/homes" class="active">الصفحه الرئيسيه</a>
                            <a href="/Viewproducts">كل منتجات</a>
                            <a href="/ViewElectronicsProducts">إلكترونيات</a>
                            <a href="/ViewClothingProducts">الملابس</a>
                            <a href="/ViewFoodProducts">الطعام</a>
                            <a href="/ViewFurnitureProducts">الاثاث</a>
                            <a href="/ViewBooksProducts">الكتب</a>
                            <a href="/ViewBeautyProducts">أدوات تجميل</a>
                            <a href="/ViewPerfumesProducts">العطور</a>
                        </nav>
                    </header>
                    
                    <div class="food-grid" id="food-grid">
                        <% products.forEach(product => { %>
                            <div class="product-card">
                                <div class="card">
                                    <div class="card-front" style="background-image: url('<%= product.image %>');">
                                        <div class="image-overlay"></div>
                                    </div>
                                    
                                    <div class="card-back">
                                        <div class="details">
                                            <h3><%= product.name %> / ID=><%= product.id %></h3>
                                            <p class="description"><%= product.description %></p>
                                            <p class="price">$<%= product.price %></p>

                                            <div class="like-container">
                                                <button class="like-button" onclick="toggleLike(this, `<%= product.id %>`)">
                                                    <span class="material-icons-round" id="like-icon-<%= product.id %>">favorite_border</span>
                                                </button>
                                                <span class="like-count" id="like-count-<%= product.id %>"><%= product.likes %></span>
                                            </div>
                                            
        
                                            <button class="buy-button" onclick="addToCart(this, <%= product.id %>, '<%= product.name %>', <%= product.price %>, '<%= product.image %>')">
                                                Add to Cart
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                </div>
            </div>
        </div>
    </div> 

    <script>
        function toggleCart() {
            const cartContainer = document.getElementById("cart-container");
            cartContainer.style.display = cartContainer.style.display === "block" ? "none" : "block";
        }

        function addToCart(button, id, name, price, image) {
            let cart = JSON.parse(localStorage.getItem("cart")) || [];
            
            let existingProduct = cart.find(item => item.id === id);
            if (existingProduct) {
                existingProduct.quantity++;
            } else {
                cart.push({ id, name, price, quantity: 1 });
            }

            localStorage.setItem("cart", JSON.stringify(cart));
            updateCartUI();
            animateProductFly(button, image);
        }

        function animateProductFly(button, image) {
            const cartIcon = document.querySelector('.cart-icon');
            const productImage = document.createElement("img");
            productImage.src = image;
            productImage.classList.add("flying-product");

            const rect = button.getBoundingClientRect();
            productImage.style.top = rect.top + "px";
            productImage.style.left = rect.left + "px";
            document.body.appendChild(productImage);

            setTimeout(() => {
                productImage.style.top = cartIcon.getBoundingClientRect().top + "px";
                productImage.style.left = cartIcon.getBoundingClientRect().left + "px";
                productImage.style.width = "20px";
                productImage.style.height = "20px";
            }, 100);

            setTimeout(() => {
                document.body.removeChild(productImage);
            }, 1000);
        }

        function updateCartUI() {
        let cart = JSON.parse(localStorage.getItem("cart")) || [];
        const cartItemsContainer = document.getElementById("cart-items");
        const cartTotalPrice = document.getElementById("cart-total-price");
        cartItemsContainer.innerHTML = "";

        let totalPrice = 0;

        cart.forEach(product => {
            totalPrice += product.price * product.quantity;
            const itemDiv = document.createElement("div");
            itemDiv.classList.add("cart-item");
            itemDiv.innerHTML = `
                <span>${product.name} (${product.quantity}) - $${product.price * product.quantity}</span>
                <button onclick="removeFromCart(${product.id})">X</button>
            `;
            cartItemsContainer.appendChild(itemDiv);
        });

        document.getElementById("cart-count").innerText = cart.reduce((acc, item) => acc + item.quantity, 0);
        cartTotalPrice.innerText = totalPrice.toFixed(2);
    }

    function removeFromCart(id) {
        let cart = JSON.parse(localStorage.getItem("cart")) || [];
        cart = cart.filter(item => item.id !== id);
        localStorage.setItem("cart", JSON.stringify(cart));
        updateCartUI();
    }

    function clearCart() {
        localStorage.removeItem("cart");
        updateCartUI();
    }

    function placeOrder() {
    let cart = JSON.parse(localStorage.getItem("cart")) || [];

    if (cart.length === 0) {
        alert("السلة فارغة!");
        return;
    }
     
    // جلب userId من الخادم
    fetch('/get_user')
    .then(response => response.json())
    .then(userData => {
        if (!userData.userId) {
            alert("يجب تسجيل الدخول أولًا!");
            return;
        }

        
    })
    .catch(error => console.error('Error fetching user data:', error));
}

    document.addEventListener("DOMContentLoaded", updateCartUI);
</script>
<script>
    function toggleLike(button, productId) {
    const icon = button.querySelector('span');
    const likeCountElement = document.getElementById(`like-count-${productId}`);
    let currentLikes = parseInt(likeCountElement.innerText);

    if (icon.innerText === 'favorite_border') {
        // User likes the product
        icon.innerText = 'favorite'; // Change to filled heart
        currentLikes++;
        updateLikesInDB(productId, currentLikes);
    } else {
        // User unlikes the product
        icon.innerText = 'favorite_border'; // Change to outlined heart
        currentLikes--;
        updateLikesInDB(productId, currentLikes);
    }

    likeCountElement.innerText = currentLikes; // Update the displayed like count
}

function updateLikesInDB(productId, likes) {
    fetch(`/update-likes/${productId}`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify({ likes: likes }),
    })
    .then(response => response.json())
    .then(data => {
        if (!data.success) {
            console.error('Error updating likes:', data.message);
        }
    })
    .catch(error => {
        console.error('Error:', error);
    });
}

</script>

</body>
</html>