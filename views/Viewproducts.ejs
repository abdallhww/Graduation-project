<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Food Delivery App</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet">
    <link rel="stylesheet" href="/style/viweprodect.css">
</head>
<body>
    <div class="app-container">
        <div id="main-app" class="screen">
            <div class="content-container">
                <div id="home-screen" class="screen-content active">
                    <header class="header">
                        <h1 class="logo">Shop</h1>
                        <nav>
                            <a href="/homes" class="active">الصفحه الرئيسه</a>
                            <a href="/Viewproducts"> كل منتجات</a>
                            <a href="/Technicalsupport"> إلكترونيات</a>
                            <a href="/Profile">ملابس</a>
                            <a href="/Brokers">طعام</a>
                            <a href="/Viewproducts">اثاث</a>
                            <a href="/Profile">كتب</a>
                            <a href="/Brokers">ادوات تجميل</a>
                            <a href="/Viewproducts">عطور</a>
                        </nav>
                    </header>
                    
                    <div class="food-grid" id="food-grid">
                        <% products.forEach(product => { %>
                            <div class="product-card">
                                <img src="<%= product.image %>" alt="<%= product.name %>">
                                <div class="details">
                                    <h3><%= product.name %> / ID=><%=product.id %></h3>
                                    <p class="category"><%= product.category %></p>
                                    <p class="description"><%= product.description %></p>
                                    <p class="price">$<%= product.price %></p>
                                    
                                    <div class="like-container">
                                        <button class="like-button" onclick="toggleLike(this)">
                                            <span class="material-icons-round">favorite_border</span>
                                        </button>
                                        <span class="like-count" id="like-count-<%= product.id %>">0</span>
                                    </div>
                                    
                                    <button class="buy-button">add to cart</button>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                </div>
            </div>
        </div>
    </div> 
</body>
</html>
