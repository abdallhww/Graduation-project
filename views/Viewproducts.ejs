<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Food Delivery App</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet">
    <link rel="stylesheet" href="/style/viweprodect.css">
</head>
<body>
    <div class="app-container">
        <div id="main-app" class="screen">
            <div class="content-container">
                <div id="home-screen" class="screen-content active">
                    <header class="header">
                        <h1 class="logo">Shop</h1>
                        <nav>
                            <a href="/homes" class="active">الصفحه الرئيسه</a>
                            <a href="/Viewproducts">كل منتجات</a>
                            <a href="/ViewElectronicsProducts">إلكترونيات</a>
                            <a href="/ViewClothingProducts">ملابس</a>
                            <a href="/ViewFoodProducts">طعام</a>
                            <a href="/ViewFurnitureProducts">أثاث</a>
                            <a href="/ViewBooksProducts">كتب</a>
                            <a href="/ViewBeautyProducts">أدوات تجميل</a>
                            <a href="/ViewPerfumesProducts">عطور</a>
                        </nav>
                    </header>
                    
                    <div class="food-grid" id="food-grid">
                        <% products.forEach(product => { %>
                            <div class="product-card">
                                <div class="card">
                                    <div class="card-front" style="background-image: url('<%= product.image %>');">
                                        <div class="image-overlay"></div> <!-- Optional overlay for better text visibility -->
                                    </div>
                                    
                                    <div class="card-back">
                                        <div class="details">
                                            <h3><%= product.name %> / ID=><%= product.id %></h3>
                                            <p class="description"><%= product.description %></p>
                                            <p class="price">$<%= product.price %></p>
                                            
                                            <div class="like-container">
                                                <button class="like-button" onclick="toggleLike(this, <%= product.id %>)">
                                                    <span class="material-icons-round" id="like-icon-<%= product.id %>">favorite_border</span>
                                                </button>
                                                <span class="like-count" id="like-count-<%= product.id %>"><%= product.likes %></span>
                                            </div>
                                            
                                            <button class="buy-button">Add to Cart</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                </div>
            </div>
        </div>
    </div> 
    <script>
        function toggleLike(button, productId) {
    const icon = button.querySelector('span');
    const likeCountElement = document.getElementById(`like-count-${productId}`);
    let currentLikes = parseInt(likeCountElement.innerText);

    if (icon.innerText === 'favorite_border') {
        // User likes the product
        icon.innerText = 'favorite'; // Change to filled heart
        currentLikes++;
        updateLikesInDB(productId, currentLikes);
    } else {
        // User unlikes the product
        icon.innerText = 'favorite_border'; // Change to outlined heart
        currentLikes--;
        updateLikesInDB(productId, currentLikes);
    }

    likeCountElement.innerText = currentLikes; // Update the displayed like count
}

function updateLikesInDB(productId, likes) {
    fetch(`/update-likes/${productId}`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify({ likes: likes }),
    })
    .then(response => response.json())
    .then(data => {
        if (!data.success) {
            console.error('Error updating likes:', data.message);
        }
    })
    .catch(error => {
        console.error('Error:', error);
    });
}

    </script>
</body>
</html>
