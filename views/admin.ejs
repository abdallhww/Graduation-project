<!DOCTYPE html>
<html lang="ar">
<head>
  <meta charset="UTF-8">
  <title>لوحة التحكم - الأدمن</title>
  <link rel="stylesheet" href="/style/admin.css" />
  <style>
    .section-title {
      grid-column: 1 / -1;
      text-align: center;
      font-size: 24px;
      font-weight: bold;
      margin: 30px 0 10px;
      color: #ffffff;
      border-bottom: 2px solid #1abc9c;
      padding-bottom: 10px;
    }
  </style>
</head>
<body>

  <header>
    <h1>لوحة تحكم الأدمن</h1>
    <div class="admin-info">
      <img src="https://cdn-icons-png.flaticon.com/512/3524/3524659.png" alt="Admin Icon">
      <span>Abdallh</span>
    </div>
  </header>

  <div class="dashboard">

    <!-- قسم الإدارة -->
    <div class="section-title">قسم الإدارة</div>

    <div class="card">
      <h2>رسائل الدعم الفني</h2>
      <form action="/showmassge" method="get">
        <button type="submit">عرض الرسائل</button>
      </form>
    </div>


    <!-- قسم الوسطاء -->
    <div class="section-title">قسم الوسطاء</div>

    <div class="card">
      <h2>إدارة الوسطاء</h2>
      <form action="/viweBrokers" method="get">
        <button type="submit">عرض الوسطاء</button>
      </form>
    </div>

    <!-- قسم التجار -->
    <div class="section-title">قسم التجار</div>

    <div class="card">
      <h2>إدارة التجار</h2>
      <form action="/showMerchants" method="get">
        <button type="submit">عرض التجار</button>
      </form>
    </div>

    <!-- قسم الطلبات -->
    <div class="section-title">قسم الطلبات</div>

    <div class="card">
      <h2>الطلبات</h2>
      <form action="/showOrders" method="get">
        <button type="submit">عرض الطلبات وحالاتها</button>
      </form>
    </div>

    <!-- قسم المبيعات -->
    <div class="section-title">قسم المبيعات</div>

    <div class="card">
      <h2>مبيعات اليوم</h2>
      <form action="/sales/today" method="get">
        <button type="submit">عرض مبيعات اليوم</button>
      </form>
    </div>

    <div class="card">
      <h2>مبيعات الأسبوع</h2>
      <form action="/sales/week" method="get">
        <button type="submit">عرض مبيعات الأسبوع</button>
      </form>
    </div>

    <div class="card">
      <h2>مبيعات الشهر</h2>
      <form action="/sales/month" method="get">
        <button type="submit">عرض مبيعات الشهر</button>
      </form>
    </div>

    <div class="card">
      <h2>إجمالي المبيعات</h2>
      <form action="/sales/total" method="get">
        <button type="submit">عرض الإجمالي</button>
      </form>
    </div>

  </div>

  <form action="/logout" method="POST" style="display: inline;">
    <button type="submit" class="logout-btn">تسجيل خروج</button>
  </form>

</body>
</html>