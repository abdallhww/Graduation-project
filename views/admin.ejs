<!DOCTYPE html>
<html lang="ar">
<head>
  <meta charset="UTF-8">
  <title>لوحة التحكم - الأدمن</title>
  <style>
    body {
      font-family: 'Arial', sans-serif;
      background: linear-gradient(135deg, #2c3e50, #3498db);
      color: #fff;
      margin: 0;
      padding: 0;
    }
    header {
      background-color: #222;
      padding: 20px;
      text-align: center;
    }
    header h1 {
      margin: 0;
    }
    .dashboard {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
      padding: 40px;
    }
    .card {
      position: relative;
      background-color: #34495e;
      padding: 30px;
      border-radius: 12px;
      text-align: center;
      box-shadow: 0 0 10px rgba(0,0,0,0.3);
      overflow: hidden;
    }
    .card:hover {
      transform: translateY(-5px);
      cursor: pointer;
    }
    .card::before {
      content: '';
      position: absolute;
      top: 0;
      right: 0;
      height: 100%;
      width: 5px;
      background: linear-gradient(to bottom, #f1c40f, #e67e22, #e74c3c);
      animation: moveStripe 2s linear infinite;
    }
    @keyframes moveStripe {
      0% { background-position: 0% 0%; }
      100% { background-position: 0% 100%; }
    }
    .card h2 {
      margin-bottom: 20px;
    }
    .card button {
      background-color: #1abc9c;
      border: none;
      color: white;
      padding: 12px 20px;
      border-radius: 8px;
      font-size: 15px;
      font-weight: bold;
      transition: background-color 0.3s ease, transform 0.2s ease;
    }
    .card button:hover {
      background-color: #16a085;
      transform: scale(1.05);
      cursor: pointer;
    }
    form {
      margin: 0;
    }
  </style>
</head>
<body>
  <header>
    <h1>لوحة تحكم الأدمن</h1>
  </header>

  <div class="dashboard">
    <div class="card">
      <h2>رسائل الدعم الفني</h2>
      <form action="/showmassge" method="get">
        <button type="submit">عرض الرسائل</button>
      </form>
    </div>

    <div class="card">
      <h2>الطلبات (Orders)</h2>
      <form action="/showOrders" method="get">
        <button type="submit">عرض الطلبات وحالاتها</button>
      </form>
    </div>

    <div class="card">
      <h2>إدارة الوسطاء</h2>
      <form action="/showBrokers" method="get">
        <button type="submit">عرض الوسطاء</button>
      </form>
    </div>

    <div class="card">
      <h2>الأسئلة الشائعة</h2>
      <form action="/faqManager" method="get">
        <button type="submit">إدارة الأسئلة</button>
      </form>
    </div>
  </div>
</body>
</html>
