<!DOCTYPE html>
<html lang="ar">
<head>
  <meta charset="UTF-8">
  <title>عرض الوسطاء</title>
  <link rel="stylesheet" href="/style/adminbroker.css">
 
</head>
<body>

  <h2>قائمة الوسطاء</h2>

  <div class="search-container">
    <form action="/searchBroker" method="get">
      <input type="text" name="name" placeholder="ابحث عن وسيط بالاسم" required>
      <button type="submit">بحث</button>
    </form>
  </div>

  <table>
    <thead>
      <tr>
        <th>الاسم</th>
        <th>البريد</th>
        <th>رقم الهاتف</th>
        <th>التقييم</th>
        <th>تاريخ التسجيل</th>
        <th>إجراء</th>
      </tr>
    </thead>
    <tbody>
      <% brokers.forEach(broker => { %>
        <tr>
          <td><%= broker.name %></td>
          <td><%= broker.emil %></td>
          <td><%= broker.phone %></td>
          <td><%= broker.Rating %></td>
          <td><%= broker.created_at.toLocaleString() %></td>
          <td>
            <form action="/deletBroker" method="post" onsubmit="return confirmDelete()">
              <input type="hidden" name="id" value="<%= broker.id %>">
              <button type="submit">حذف</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <form action="/goadminhome" method="POST">
    <button type="submit" class="logout-btn">ذهاب إلى الصفحة الرئيسية</button>
  </form>

  <script>
    function confirmDelete() {
      return confirm("هل أنت متأكد أنك تريد حذف هذا الوسيط؟");
    }
  </script>

</body>
</html>
