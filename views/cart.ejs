<!DOCTYPE html>
<html lang="ar">
<head>
    <meta charset="UTF-8">
    <title>سلة المشتريات</title>
    <link rel="stylesheet" href="/style/cart.css">
</head>
<body>
    
    <form action="/Viewproducts" method="get" style="display: inline;">
        <button type="submit" class="gradient-btn">عرض المنتجات</button>
    </form>

    <div class="cart-container">
        <h2>سلة المشتريات</h2>
        <% if (cartItems.length === 0) { %>
            <p>لا توجد منتجات في السلة.</p>
        <% } else { %>
            <% cartItems.forEach(item => { %>
                <div class="cart-item">
                    <img src="<%= item.image %>" alt="<%= item.name %>">
                    <div class="cart-item-details">
                        <h4><%= item.name %></h4>
                        <p>السعر: $<%= parseFloat(item.price).toFixed(2) %></p>
                    </div>
                    <form action="/cart/delete" method="POST" style="display:inline;">
                        <input type="hidden" name="cart_item_id" value="<%= item.cart_item_id %>">
                        <input type="hidden" name="product_id" value="<%= item.product_id %>">
                        <input type="hidden" name="user_id" value="<%= userId %>">
                        <button type="submit" class="delete-btn">حذف</button>
                    </form>
                    
                </div>
            <% }); %>
            <div class="total-price">
                <strong>الإجمالي: $<%= totalPrice %></strong>
            </div>
        <% } %>

        <form action="/submit-order/:userId" method="POST" style="display:inline;">
            <button type="submit" class="delete-btn"> تسجيل طلب</button>
          </form>
    </div>

</body>
</html>