<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <title>منتجات التاجر <%= merchantName %></title>
  <link rel="stylesheet" href="/style/merchantProducts.css">
</head>
<body>

    <form action="/calculateSalesReport" method="GET" style="margin-bottom: 30px;">
  <label>من: <input type="date" name="startDate" required></label>
  <br>
  <label>إلى: <input type="date" name="endDate" required></label>
  <br>
  <input type="hidden" name="merchantName" value="<%= merchantName %>">
  <button type="submit">انشاء  التقرير</button>
</form>

  <h1>منتجات التاجر: <%= merchantName %></h1>

  <% if (products.length > 0) { %>
    <table>
      <thead>
        <tr>
          <th>اسم المنتج</th>
          <th>الكمية</th>
          <th>السعر للوحدة</th>
          <th>تاريخ الطلب</th>
        </tr>
      </thead>
      <tbody>
        <% products.forEach(product => { %>
          <tr>
            <td><%= product.product_name %></td>
            <td><%= product.quantity %></td>
            <td><%= product.product_price %>$</td>
            <td><%= product.creatdat.toLocaleString() %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <p>لا توجد منتجات لهذا التاجر.</p>
  <% } %>

  <a href="/showMerchants">العودة لقائمة التجار</a>

</body>
</html>
