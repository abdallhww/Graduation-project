<!DOCTYPE html>
<html lang="ar">
<head>
  <meta charset="UTF-8">
  <title>ملاحظاتي</title>
   <link rel="stylesheet" href="/style/my-notes.css">
</head>
<body>
  <div class="container">
    <h2>جميع الملاحظات التي كتبتها</h2>

    <% if (notes.length > 0) { %>
      <table>
        <thead>
          <tr>
            <th>رقم الطلب</th>
            <th>الحالة</th>
            <th>السعر الكلي</th>
            <th>الملاحظة</th>
            <th>تاريخ انشاء طلب </th>
            <th>رد</th>
          </tr>
        </thead>
        <tbody>
          <% notes.forEach(note => { %>
            <tr>
              <td><%= note.order_id %></td>
              <td><%= note.status %></td>
              <td><%= note.total_price %> د.ع</td>
              <td><%= note.note %></td>
              <td><%= new Date(note.created_at).toLocaleString("ar-EG") %></td>
              <td><%= note.reply %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <p style="text-align:center;">لم تقم بإضافة أي ملاحظات بعد.</p>
    <% } %>

    <button class="logout-btn" onclick="goBack()">رجوع</button>

    <script>
      function goBack() {
        window.history.back();
      }
    </script>
  </div>
</body>
</html>