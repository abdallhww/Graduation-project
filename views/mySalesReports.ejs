<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <title>تقاريري</title>
  <style>
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: linear-gradient(to right, #1e3c72, #2a5298);
      color: #fff;
      text-align: center;
      padding: 40px;
    }

    h1 {
      margin-bottom: 30px;
    }

    table {
      margin: 0 auto;
      width: 90%;
      border-collapse: collapse;
      background-color: rgba(255, 255, 255, 0.1);
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
    }

    th, td {
      padding: 12px 15px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    }

    th {
      background-color: rgba(255, 255, 255, 0.2);
      color: #ffd700;
    }

    td {
      color: #fff;
    }

    tr:hover {
      background-color: rgba(255, 255, 255, 0.1);
    }

    .paid {
      color: #00ff7f;
      font-weight: bold;
    }

    .unpaid {
      color: #ff8080;
      font-weight: bold;
    }

    a {
      display: inline-block;
      margin-top: 30px;
      padding: 10px 20px;
      background-color: #ffd700;
      color: #000;
      text-decoration: none;
      border-radius: 8px;
      transition: background-color 0.3s ease;
    }

    a:hover {
      background-color: #e0c200;
    }
  </style>
</head>
<body>
  <h1>تقارير المبيعات الخاصة بي</h1>

  <% if (reports.length > 0) { %>
    <table>
      <thead>
        <tr>
          <th>من تاريخ</th>
          <th>إلى تاريخ</th>
          <th>إجمالي المبيعات ($)</th>
          <th>نسبة المتجر (%)</th>
          <th>حصة المتجر ($)</th>
          <th>تعليق الإدمن</th>
          <th>الحالة</th>
          <th>تاريخ التسجيل</th>
        </tr>
      </thead>
      <tbody>
        <% reports.forEach(r => { %>
          <tr>
            <td><%= r.start_date.toISOString().split('T')[0] %></td>
            <td><%= r.end_date.toISOString().split('T')[0] %></td>
            <td><%= Number(r.total_sales).toFixed(2) %></td>
            <td><%= Number(r.store_percentage).toFixed(2) %></td>
            <td><%= Number(r.store_share).toFixed(2) %></td>
            <td><%= r.admin_comment || '---' %></td>
            <td class="<%= r.payment_status === 'مدفوع' ? 'paid' : 'unpaid' %>"><%= r.payment_status %></td>
            <td><%= r.recorded_at.toLocaleString() %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <p>لا توجد تقارير مبيعات خاصة بك حتى الآن.</p>
  <% } %>

  <button class="btn-home" onclick="goBack()">رجوع</button>

    <script>
      function goBack() {
        window.history.back();
      }
    </script>
</body>
</html>