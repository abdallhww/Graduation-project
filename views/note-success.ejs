<!DOCTYPE html>
<html lang="ar">
<head>
  <meta charset="UTF-8">
  <title>تمت إضافة الملاحظة</title>
  <style>
    body {
      background: linear-gradient(to right, #1d3557, #457b9d);
      color: white;
      font-family: 'Cairo', sans-serif;
      text-align: center;
      padding-top: 100px;
    }
    .box {
      background: rgba(255, 255, 255, 0.1);
      padding: 30px;
      border-radius: 15px;
      display: inline-block;
    }
    a {
      color: #f1faee;
      text-decoration: underline;
    }
  </style>
</head>
<body>
  <div class="box">
    <h1>✅ تم إضافة الملاحظة بنجاح</h1>
   <button class="btn-home" onclick="goBack()">رجوع</button>
  </div>
   <script>
      function goBack() {
        window.history.back();
      }
    </script>
</body>
</html>