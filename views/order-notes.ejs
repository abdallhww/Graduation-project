<!DOCTYPE html>
<html lang="ar">
<head>
  <meta charset="UTF-8">
  <title>ملاحظات الطلب <%= orderId %></title>
  <style>
    body {
      background: linear-gradient(to right, #141e30, #243b55);
      color: white;
      font-family: 'Cairo', sans-serif;
      direction: rtl;
      padding: 20px;
    }
    .note-box {
      background: rgba(255, 255, 255, 0.1);
      margin: 15px 0;
      padding: 15px;
      border-radius: 10px;
      box-shadow: 0 0 10px rgba(0,0,0,0.2);
    }
    .note-box strong {
      color: #00d4ff;
    }
    .back-btn {
      padding: 10px 20px;
      background: #00b4d8;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      color: white;
      font-size: 16px;
      margin-top: 20px;
    }
    .back-btn:hover {
      background: #0077b6;
    }
  </style>
</head>
<body>
  <h2>ملاحظات الطلب رقم <%= orderId %></h2>

  <% if (notes.length > 0) { %>
    <% notes.forEach(note => { %>
      <div class="note-box">
        <strong><%= note.broker_name %></strong> - <%= new Date(note.created_at).toLocaleString("ar-EG") %><br>
        <p><%= note.note %></p>
      </div>
    <% }) %>
  <% } else { %>
    <p>لا توجد ملاحظات بعد لهذا الطلب.</p>
  <% } %>

  <button onclick="history.back()" class="back-btn">رجوع</button>
</body>
</html>