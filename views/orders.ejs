<!DOCTYPE html>
<html lang="ar">
    <link rel="stylesheet" href="/style/orders.css"> 
<head>
    <meta charset="UTF-8">
    <title>طلباتي</title>
</head>
<body>

    <div class="orders-container">
        <h2 style="text-align: center; margin-bottom: 20px;">طلباتي</h2>
        <h3 style="text-align: center; margin-bottom: 20px;">تفاصيل طلب</h3>

        <!-- تم تعديل الفورم -->
        <form action="/searchOrderItems" method="get" class="search-form">
            <input type="number" name="orderId" placeholder="ادخل رقم الطلب" required class="search-input" />
            <button type="submit" class="search-btn">بحث</button>
        </form>

        <% if (orders.length === 0) { %>
            <p style="text-align: center;">لم تقم بأي طلبات حتى الآن.</p>
        <% } else { %>
            <% orders.forEach(order => { %>
                <div class="order-card">
                    <h3>رقم الطلب: <%= order.id %></h3>
                    <div class="order-info">
                        <p><strong>تاريخ الطلب:</strong> <%= new Date(order.created_at).toLocaleString() %></p>
                        <p><strong>السعر الإجمالي:</strong> $<%= parseFloat(order.total_price).toFixed(2) %></p>
                        <p><strong>الحالة:</strong> <%= order.status %></p>
                    </div>
                </div>
            <% }) %>
        <% } %>

        <div style="text-align: center;">
            <button class="back-btn" onclick="window.history.back()">رجوع</button>
        </div>
    </div>

</body>
</html>