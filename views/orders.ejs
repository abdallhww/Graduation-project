<!DOCTYPE html>
<html lang="ar">
<head>
    <meta charset="UTF-8">
    <title>طلباتي</title>
    <style>
        body {
            background-color: #1e1e2f;
            color: white;
            font-family: 'Arial', sans-serif;
            padding: 30px;
        }

        .orders-container {
            max-width: 900px;
            margin: auto;
            background: rgba(255, 255, 255, 0.05);
            padding: 25px;
            border-radius: 15px;
            backdrop-filter: blur(10px);
        }

        .order-card {
            background: rgba(255, 255, 255, 0.1);
            margin-bottom: 20px;
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
        }

        .order-card h3 {
            margin-top: 0;
        }

        .order-info {
            margin-top: 10px;
            line-height: 1.6;
        }

        .back-btn {
            margin-top: 30px;
            padding: 12px 24px;
            background: linear-gradient(135deg, #4e54c8, #8f94fb);
            border: none;
            border-radius: 10px;
            color: white;
            font-size: 16px;
            cursor: pointer;
        }

        .back-btn:hover {
            transform: scale(1.05);
        }
    </style>
</head>
<body>

    <div class="orders-container">
        <h2>طلباتي</h2>

        <% if (orders.length === 0) { %>
            <p>لم تقم بأي طلبات حتى الآن.</p>
        <% } else { %>
            <% orders.forEach(order => { %>
                <div class="order-card">
                    <h3>رقم الطلب: <%= order.id %></h3>
                    <div class="order-info">
                        <p><strong>تاريخ الطلب:</strong> <%= new Date(order.created_at).toLocaleString() %></p>
                        <p><strong>السعر الإجمالي:</strong> $<%= parseFloat(order.total_price).toFixed(2) %></p>
                        <p><strong>الحالة:</strong> <%= order.status %></p>
                    </div>
                </div>
            <% }) %>
        <% } %>

        <button class="back-btn" onclick="window.history.back()">رجوع</button>
    </div>

</body>
</html>
