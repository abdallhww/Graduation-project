<!DOCTYPE html>
<html lang="ar">
     <link rel="stylesheet" href="/style/payment.css"> 
<head>
    <meta charset="UTF-8">
    <title>اختيار طريقة الدفع</title>
</head>
<body>

    <label> اختيار وسيط</label>
    <form action="/Brokers2" method="get" style="display: inline;">
    <button type="submit" class="payment-btn">عرض الوسطاء</button>
</form>
<hr>

    <!-- معلومات الطلب -->
    <div class="order-info">
        <p><strong>رقم الطلب:</strong> <%= order.id %></p>
        <p><strong>تاريخ الطلب:</strong> <%= order.created_at.toLocaleString() %></p>
        <p><strong>إجمالي السعر:</strong> $<%= order.total.toFixed(2) %></p>
    </div>

</body>
</html>