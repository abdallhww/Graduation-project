<!DOCTYPE html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
     <link rel="stylesheet" href="/style/payment2.css">
    <title>الدفع</title>
  </head>
  <body>
    <div class="container">
      <h1>checkout</h1>
      <h2>معلومات الطلب</h2>
      <p>رقم الطلب: <%= orderId %></p>
      <p>اسم الوسيط: <%= brokerName %>//<%= brokerId %> </p>
      <p>السعر الإجمالي: $<%= totalPrice %></p>

      <% if (orderLocation) { %>
        <p>📍 موقع الاستلام: <strong><%= orderLocation %></strong></p>
      <% } %>

      <!-- إدخال موقع الاستلام -->
      <form action="/save-location/<%= brokerId %>" method="POST" class="form-group">
        <input type="hidden" name="orderId" value="<%= orderId %>">
        <input
          type="text"
          name="location"
          placeholder="أدخل موقع الاستلام"
          required
        />
        <button type="submit" class="payment-btn">حفظ الموقع</button>
      </form>

      <!-- خيارات الدفع -->
      <div class="payment-options">
        <div class="payment-option">
          <form action="/complete-payment" method="POST">
            <input type="hidden" name="orderId" value="<%= orderId %>">
            <input type="hidden" name="paymentMethod" value="الدفع عند الاستلام">
            <button type="submit" class="payment-btn">الدفع عند الاستلام</button>
          </form>
        </div>

        <!--<div class="payment-option">
          <form action="/complete-payment2" method="POST">
            <input type="hidden" name="orderId" value="<%= orderId %>">
            <input type="hidden" name="paymentMethod" value="بطاقة إلكترونية">
            <button type="submit" class="payment-btn">الدفع ببطاقة إلكترونية</button>
          </form>
        </div>-->

        <div class="payment-option">
          <form action="/complete-payment3" method="POST">
            <input type="hidden" name="orderId" value="<%= orderId %>">
            <input type="hidden" name="paymentMethod" value="PayPal">
            <input type="hidden" name="totalPrice" value="<%= totalPrice %>">
            <button type="submit" class="payment-btn">دفع PayPal  </button>  
          </form>
        </div>
      </div>
    </div>
  </body>
</html>