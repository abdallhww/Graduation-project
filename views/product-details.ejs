<!DOCTYPE html>
<html lang="ar">
<head>
  <meta charset="UTF-8">
  <title>تفاصيل المنتج</title>
  <link rel="stylesheet" href="/style/product-details.css">
</head>
<body>
  <div class="product-detail-container">
    <h1><%= product.name %></h1>
    <img src="<%= product.image %>" alt="<%= product.name %>">
    <p><strong>الوصف:</strong> <%= product.description %></p>
    <p><strong>السعر:</strong> $<%= product.price %></p>
    <p><strong>الكمية المتوفرة:</strong> <%= product.stock_quantity %></p>
    <p><strong>القسم:</strong> <%= product.category %></p>
    <p><strong>الإعجابات:</strong> <%= product.likes %></p>
    <button onclick="addToCart('<%= product.id %>')">🛒 إضافة إلى السلة</button>
    <button onclick="goBack()">⬅ العودة</button>
  </div>

  <script>
    function goBack() {
      window.history.back();
    }
    
    function addToCart(productId) {
        // الخطوة 1: الحصول على userId من الجلسة
        fetch('/get_user')
            .then(response => response.json())
            .then(userData => {
                if (!userData.userId) {
                    alert("يجب تسجيل الدخول أولًا!");
                    return;
                }
    
                const userId = userData.userId;
    
                // الخطوة 2: إرسال الطلب لإضافة المنتج إلى السلة
                fetch('/add-to-cart', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        userId: userId,
                        productId: productId
                    })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert("تمت إضافة المنتج إلى السلة!");
                    } else {
                        alert("حدث خطأ أثناء الإضافة!");
                    }
                })
                .catch(error => {
                    console.error("Error:", error);
                });
    
            });
    }
    </script>
</body>
</html>
