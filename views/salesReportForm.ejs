<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <title>تقرير مبيعات <%= merchantName %></title>
  <style>
    /* نفس تصميم جدول المنتجات مع إضافة بسيطة للنموذج */
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: linear-gradient(to right, #1e3c72, #2a5298);
      color: #fff;
      padding: 40px;
      text-align: center;
    }
    table {
      margin: 0 auto;
      width: 80%;
      border-collapse: collapse;
      background-color: rgba(255,255,255,0.1);
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 4px 10px rgba(0,0,0,0.3);
    }
    th, td {
      padding: 12px 15px;
      border-bottom: 1px solid rgba(255,255,255,0.2);
    }
    th {
      background-color: rgba(255,255,255,0.2);
      color: #ffd700;
    }
    tr:hover {
      background-color: rgba(255,255,255,0.1);
    }
    input, textarea {
      width: 80%;
      padding: 10px;
      margin: 10px auto;
      display: block;
      border-radius: 6px;
      border: none;
      font-size: 16px;
    }
    button {
      padding: 12px 25px;
      background-color: #ffd700;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      font-weight: bold;
      margin-top: 20px;
      color: #000;
    }
  </style>
</head>
<body>
  <h1>تقرير مبيعات التاجر: <%= merchantName %></h1>
  <p>الفترة من <%= startDate %> إلى <%= endDate %></p>

  <% if (products.length > 0) { %>
  <table>
    <thead>
      <tr>
        <th>اسم المنتج</th>
        <th>الكمية</th>
        <th>السعر للوحدة</th>
        <th>التاريخ</th>
        <th>الإجمالي</th>
      </tr>
    </thead>
    <tbody>
      <% products.forEach(product => { %>
        <tr>
          <td><%= product.product_name %></td>
          <td><%= product.quantity %></td>
          <td><%= product.price %> $</td>
          <td><%= new Date(product.creatdat).toLocaleString() %></td>
          <td><%= (product.quantity * product.price).toFixed(2) %> $</td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <h2>إجمالي المبيعات: $<%= totalSales %></h2>

  <form action="/saveSalesReport" method="POST">
    <input type="hidden" name="merchantId" value="<%= merchantId %>" />
    <input type="hidden" name="startDate" value="<%= startDate %>" />
    <input type="hidden" name="endDate" value="<%= endDate %>" />
    <input type="hidden" name="totalSales" value="<%= totalSales %>" />

    <label>نسبة المتجر (%):</label>
    <input type="number" step="0.01" name="storePercentage" value="<%= storePercentage %>" required />

    <label>تعليق الأدمن:</label>
    <textarea name="adminComment" placeholder="اكتب تعليقاً هنا..." rows="4"></textarea>

    <h3>نسبة المتجر: $<%= storeShare %></h3>

    <button type="submit">حفظ التقرير</button>
  </form>

  <% } else { %>
    <p>لا توجد مبيعات في هذه الفترة.</p>
  <% } %>

  <a href="/showMerchants" style="color:#ffd700; display:block; margin-top: 40px;">العودة لقائمة التجار</a>
</body>
</html>