<!DOCTYPE html>
<html lang="ar">
<head>
  <meta charset="UTF-8">
  <title>مبيعات اليوم</title>
  <link rel="stylesheet" href="/style/salesalltime.css" />
  
</head>
<body>
  <h2>عرض المبيعات حسب التاريخ</h2>
<form action="/filter" method="GET" style="margin-bottom: 30px;">
  <input type="date" id="from" name="from" required>
  <label for="from">من تاريخ:</label>
<hr>
  <input type="date" id="to" name="to" required>
   <label for="to">إلى تاريخ:</label>
<hr>
  <button type="submit" class="logout-btn" style="margin-top: 10px;">عرض</button>
</form>

  <h1>مبيعات </h1>


  <% if (sales.length > 0) { %>
    <table>
      <tr>
        <th>اسم المنتج</th>
        <th>السعر</th>
        <th>الكمية</th>
        <th>التاريخ</th>
      </tr>
      <% sales.forEach(item => { %>
        <tr>
          <td><%= item.product_name %></td>
          <td><%= item.price %></td>
          <td><%= item.quantity %></td>
          <td><%= item.creatdat %></td>

        </tr>
      <% }) %>
    </table>
  <% } else { %>
    <p>لا توجد مبيعات الشهر.</p>
  <% } %>
  
  <p>عدد المنتجات المباعة: <%= totalSales %></p>
  <p>إجمالي المبلغ: <%= totalAmount.toFixed(2) %> دولار</p>

  <!--<form action="/saleschart" method="GET" style="display: inline;">
    <button type="submit" class="logout-btn" style="margin-top: 10px;">عرض الرسم البياني للمبيعات</button>
  </form>-->

  <form action="/goadminhome" method="POST" style="display: inline;">
    <button type="submit" class="logout-btn">ذهاب إلى الصفحة الرئيسية</button>
  </form>
</body>
</html>