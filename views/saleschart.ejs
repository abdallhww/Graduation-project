<!DOCTYPE html>
<html lang="ar">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>مبيعات الشهر</title>
  <!-- إضافة مكتبة Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f4f4f9;
      text-align: center;
      margin-top: 30px;
    }
    .container {
      max-width: 800px;
      margin: 0 auto;
      background: white;
      padding: 20px;
      border-radius: 10px;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }
    h1 {
      color: #333;
    }
    canvas {
      margin-top: 20px;
    }
  </style>
</head>
<body>

  <div class="container">
    <h1>رسم بياني لمبيعات الشهر</h1>
    <canvas id="salesChart"></canvas>
  </div>

  <script>
    const salesData = <%= JSON.stringify(salesData) %>;

    const ctx = document.getElementById('salesChart').getContext('2d');
    const salesChart = new Chart(ctx, {
      type: 'line', // نوع الرسم البياني (خط)
      data: {
        labels: salesData.labels, // التواريخ
        datasets: [{
          label: 'المبيعات',
          data: salesData.values, // قيم المبيعات
          borderColor: '#4e73df',
          backgroundColor: 'rgba(78, 115, 223, 0.2)',
          borderWidth: 2,
          tension: 0.4 // لتنعيم الخط
        }]
      },
      options: {
        responsive: true,
        scales: {
          x: {
            title: {
              display: true,
              text: 'التاريخ'
            }
          },
          y: {
            title: {
              display: true,
              text: 'المبيعات'
            },
            beginAtZero: true
          }
        }
      }
    });
  </script>

</body>
</html>
