<!DOCTYPE html>
<html lang="ar">
<head>
  <meta charset="UTF-8">
  <title>مبيعات اليوم</title>
  <style>
     body {
    background: linear-gradient(135deg, #2c3e50, #3498db);
    color: white;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: start;
    padding: 40px 20px;
    min-height: 100vh;
    text-align: center;
  }
    table {
  direction: rtl; /* إذا كنت تريد الجدول يبدأ من اليمين */
  width: 100%;
  border-collapse: collapse;
}

th, td {
  padding: 10px;
  border: 1px solid #ccc;
  text-align: center;
}
.logout-btn {
  background-color: #2980b9;
  color: white;
  border: none;
  padding: 12px 24px;
  font-size: 16px;
  border-radius: 8px;
  cursor: pointer;
  margin-top: 20px;
  transition: all 0.3s ease;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.2);
}

.logout-btn:hover {
  background-color: #3daee9;
  box-shadow: 0 0 15px rgba(52, 152, 219, 0.8);
}

  </style>
</head>
<body>
  <h1>مبيعات الاسبوع</h1>

  <h1>مبيعات الاسبوع من <%= startDate %> إلى <%= endDate %></h1>

  <% if (sales.length > 0) { %>
    <table>
      <tr>
        <th>اسم المنتج</th>
        <th>السعر</th>
        <th>الكمية</th>
        <th>التاريخ</th>
      </tr>
      <% sales.forEach(item => { %>
        <tr>
          <td><%= item.product_name %></td>
          <td><%= item.price %></td>
          <td><%= item.quantity %></td>
          <td><%= item.creatdat %></td>

        </tr>
      <% }) %>
    </table>
  <% } else { %>
    <p>لا توجد مبيعات الاسبوع.</p>
  <% } %>

  <p>عدد المنتجات المباعة: <%= totalSales %></p>
  <form action="/goadminhome" method="POST" style="display: inline;">
    <button type="submit" class="logout-btn">ذهاب إلى الصفحة الرئيسية</button>
  </form>
</body>
</html>
