<!DOCTYPE html>
<html lang="ar">
<head>
  <meta charset="UTF-8">
  <title>مبيعات اليوم</title>
  <link rel="stylesheet" href='/style/selestoday.css'>
</head>
<body>
  <h1>مبيعات اليوم</h1>

  <% if (sales.length > 0) { %>
    <table>
      <tr>
        <th>اسم المنتج</th>
        <th>السعر</th>
        <th>الكمية</th>
        <th>التاريخ</th>
      </tr>
      <% sales.forEach(item => { %>
        <tr>
          <td><%= item.product_name %></td>
          <td><%= item.price %></td>
          <td><%= item.quantity %></td>
          <td><%= item.creatdat %></td>
        </tr>
      <% }) %>
    </table>
  <% } else { %>
    <p>لا توجد مبيعات اليوم.</p>
  <% } %>

  <p>عدد المنتجات المباعة: <%= totalSales %></p>
  <p>إجمالي المبلغ: <%= totalAmount.toFixed(2) %> دولار</p>

  <form action="/goadminhome" method="POST" style="display: inline;">
    <button type="submit" class="logout-btn">ذهاب إلى الصفحة الرئيسية</button>
  </form>
</body>
</html>
