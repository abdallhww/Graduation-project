<!DOCTYPE html>
<html lang="ar">
<head>
  <meta charset="UTF-8">
  <title>قائمة التجار</title>
  <link rel="stylesheet" href='/style/showMerchants.css'>
</head>
<body>

<h1>قائمة التجار</h1>

<table>
  <thead>
    <tr>
      <th>الصورة</th>
      <th>اسم المستخدم</th>
      <th>البريد الإلكتروني</th>
      <th>رقم الهاتف</th>
    </tr>
  </thead>
  <tbody>
    <% merchants.forEach(merchant => { %>
      <tr>
        <td><img src="<%= merchant.profile_picture %>" alt="Profile Picture"></td>
        <td><%= merchant.username %></td>
        <td><%= merchant.email %></td>
        <td><%= merchant.phone %></td>
      </tr>
    <% }) %>
  </tbody>
</table>

<form action="/goadminhome" method="POST" style="display: inline;">
    <button type="submit" class="logout-btn">ذهاب إلى الصفحة الرئيسية</button>
</form>

</body>
</html>