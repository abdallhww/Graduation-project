<!DOCTYPE html>
<html lang="ar">
<head>
  <meta charset="UTF-8">
  <title>قائمة التجار</title>
  <link rel="stylesheet" href='/style/showMerchants.css'>
</head>
<body>

  <form action="/searchMerchantProducts" method="GET" style="margin-bottom: 20px;">
  <input type="text" id="merchantName" name="merchantName" required>
  <button type="submit">بحث</button>
  <label for="merchantName">ادخل اسم تاجر لعرض منتجات مباعه التي تخص تاجر</label>
</form>


<h1>قائمة التجار</h1>

<table>
  <thead>
    <tr>
      <th>الصورة</th>
      <th>اسم المستخدم</th>
      <th>البريد الإلكتروني</th>
      <th>رقم الهاتف</th>
    </tr>
  </thead>
  <tbody>
    <% merchants.forEach(merchant => { %>
      <tr>
        <td><img src="<%= merchant.profile_picture %>" alt="Profile Picture"></td>
        <td><%= merchant.username %></td>
        <td><%= merchant.email %></td>
        <td><%= merchant.phone %></td>
      </tr>
    <% }) %>
  </tbody>
</table>

<form action="/goadminhome" method="POST" style="display: inline;">
    <button type="submit" class="logout-btn">ذهاب إلى الصفحة الرئيسية</button>
</form>

<form action="/salesReports" method="get" style="display: inline;">
    <button type="submit" class="logout-btn">  تقارير</button>
</form>

</body>
</html>