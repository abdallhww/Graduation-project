<!DOCTYPE html>
<html lang="ar">
<head>
  <meta charset="UTF-8">
  <title>رسائل الدعم الفني</title>
  <link rel="stylesheet" href="/style/showmassge.css">
  
</head>
<body>

  <h2>لوحة تحكم الدعم الفني</h2>

  <div class="action-group">
    <form action="/supportStats" method="get">
      <button type="submit" class="logout-btn">عرض الإحصائيات</button>
    </form>
    <form action="/goadminhome" method="POST">
      <button type="submit" class="logout-btn">الصفحة الرئيسية</button>
    </form>
  </div>

  <table>
    <thead>
      <tr>
        <th>الاسم</th>
        <th>البريد</th>
        <th>الرسالة</th>
        <th>التاريخ</th>
        <th>الحالة</th>
        <th>الإجراءات</th>
      </tr>
    </thead>
    <tbody>
      <% showmassge.forEach(msg => { %>
        <tr>
          <td><%= msg.name %></td>
          <td><%= msg.email %></td>
          <td><%= msg.message %></td>
          <td><%= msg.created_at.toLocaleString() %></td>
          <td><%= msg.status %></td>
          <td>
            <!-- تحديث الحالة -->
            <form action="/updateStatus" method="post">
              <input type="hidden" name="id" value="<%= msg.id %>">
              <select name="status">
                <option value="بانتظار الرد" <%= msg.status === 'بانتظار الرد' ? 'selected' : '' %>>بانتظار الرد</option>
                <option value="تم الرد" <%= msg.status === 'تم الرد' ? 'selected' : '' %>>تم الرد</option>
                <option value="مغلق" <%= msg.status === 'مغلق' ? 'selected' : '' %>>مغلق</option>
              </select>
              <button type="submit">تحديث</button>
            </form>

            <!-- حذف الرسالة -->
            <form action="/deleteMessage" method="post" onsubmit="return confirm('هل أنت متأكد من حذف هذه الرسالة؟');" style="margin-top: 5px;">
              <input type="hidden" name="id" value="<%= msg.id %>">
              <button type="submit" style="background-color:#e74c3c;">🗑 حذف</button>
            </form>

            <!-- الرد على الرسالة -->
            <form action="/replyMessage" method="post" style="margin-top:10px;">
              <input type="hidden" name="id" value="<%= msg.id %>">
              <textarea name="reply" placeholder="اكتب الرد هنا..." rows="2"></textarea>
              <button type="submit" style="margin-top:5px;">إرسال الرد</button>
            </form>

            <% if (msg.reply) { %>
              <div class="reply-box">
                <strong>الرد:</strong> <%= msg.reply %>
              </div>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>

</body>
</html>
