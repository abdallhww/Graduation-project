<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
   <title>طلبات الوسيط<%= brokerName %></title>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700&display=swap" rel="stylesheet">
   <link rel="stylesheet" href='/style/showorderadmin.css'>
  
</head>
<body>

  <h2>إدارة الطلبات</h2>
  <h3>عرض منتجات موجوده في طلب</h3>

  <form action="/searchOrderItems" method="get">
    <input type="number" name="orderId" placeholder="ادخل رقم الطلب" required />
    <button type="submit">بحث</button>
  </form>

  <hr>

  <table>
    <thead>
      <tr>
        <th>رقم الطلب</th>
        <th>اسم العميل</th>
        <th>اسم وسيط</th>
        <th>طريقة الدفع</th>
        <th>الحالة</th>
        <th>السعر الإجمالي</th>
        <th>موقع الاستلام</th>
        <th>تاريخ الإنشاء</th>
        <th>تعديل / حذف</th>
      </tr>
    </thead>
    <tbody>
      <% orders.forEach(order => { %>
        <tr>
          <td data-label="رقم الطلب"><%= order.id %></td>
          <td data-label="اسم العميل"><%= order.username %></td>
          <td><%= order.broker_name || 'لا يوجد' %></td>
          <td data-label="طريقة الدفع"><%= order.payment_method %></td>
          <td data-label="الحالة"><%= order.status %></td>
          <td data-label="السعر الإجمالي"><%= order.total_price %>$</td>
          <td data-label="موقع الاستلام"><%= order.location %>$</td>
          <td data-label="تاريخ الإنشاء"><%= new Date(order.created_at).toLocaleString('ar-EG') %></td>
          <td data-label="تعديل / الغاء طلب">
            <form action="/updateOrderStatus" method="post" style="display:inline;">
              <input type="hidden" name="id" value="<%= order.id %>">
              <select name="status">
                <option value="قيد المعالجة" <%= order.status === 'قيد المعالجة' ? 'selected' : '' %>>قيد المعالجة</option>
                <option value="تم الشحن" <%= order.status === 'تم الشحن' ? 'selected' : '' %>>تم الشحن</option>
                <option value="تم التوصيل" <%= order.status === 'تم التوصيل' ? 'selected' : '' %>>تم التوصيل</option>
                <option value="ملغي" <%= order.status === 'ملغي' ? 'selected' : '' %>>ملغي</option>
              </select>
              <button type="submit">تحديث</button>
            </form>

            <form action="/deleteOrder" method="post" onsubmit="return confirm('هل أنت متأكد من الغاء هذا الطلب؟');" style="display:inline;">
              <input type="hidden" name="id" value="<%= order.id %>">
              <button type="submit" class="delete-btn">🗑 الغاء طلب</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <form action="/viweBrokers" method="get">
    <button type="submit" class="logout-btn">الرجوع الي صفحة ادارة الوسطاء</button>
  </form>

</body>
</html>