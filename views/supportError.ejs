<!DOCTYPE html>
<html lang="ar">
<head>
  <meta charset="UTF-8">
  <title>خطأ في الدعم الفني</title>
  <style>
    body {
      background: linear-gradient(135deg, #00c9a7, #005f73, #0a9396);
      font-family: 'Arial', sans-serif;
      color: white;
      text-align: center;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0;
    }

    .box {
      background: #fff;
      color: #333;
      padding: 30px 40px;
      border-radius: 15px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.3);
      animation: bounce 2s ease;
      max-width: 400px;
    }

    @keyframes bounce {
      0% { transform: scale(0.5); opacity: 0; }
      50% { transform: scale(1.05); opacity: 1; }
      100% { transform: scale(1); }
    }

    .icon {
      font-size: 60px;
      color: rgb(203, 30, 108);
      margin-bottom: 10px;
    }

    button {
      margin-top: 20px;
      padding: 10px 20px;
      font-size: 16px;
      border: none;
      border-radius: 8px;
      background-color: #ff2770;
      color: white;
      cursor: pointer;
      transition: background-color 0.3s ease;
    }

    button:hover {
      background-color: #029d85;
    }
  </style>
</head>
<body>
  <div class="box">
    <h2>عذرًا، حدث خطأ</h2>
    <p><%= message %></p>

    <button onclick="goBack()">رجوع</button>

    <script>
      function goBack() {
        window.history.back();
      }
    </script>
   
  </div>
</body>
</html>
