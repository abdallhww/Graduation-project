<!DOCTYPE html>
<html lang="ar">
<head>
  <meta charset="UTF-8">
   <link rel="stylesheet" href='/style/userMassege.css'>
  <title>الرسائل الداعمة</title>
</head>
<body>
  <h1>الرسائل الخاصة بك</h1>

  <% if (userMessages.length === 0) { %>
    <p>لا توجد رسائل حالياً.</p>
  <% } else { %>
    <% userMessages.forEach(msg => { %>
      <div class="card">
        <p><strong>الحالة:</strong> <%= msg.status %></p>
        <p><strong>الرسالة:</strong> <%= msg.message %></p>
        <p class="timestamp"><%= msg.created_at.toLocaleString() %></p>
        <p claas="timestamp"><strong>رد:  </strong><%= msg.reply %></p>
      </div>
    <% }) %>
  <% } %>

  <button onclick="goBack()">رجوع</button>

    <script>
      function goBack() {
        window.history.back();
      }
    </script>
</body>
</html>